NODE_ENV=development

PORT=5000

FRONTEND_URL=http://127.0.0.1:5173

DATABASE_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Server-only AI configuration. Leave unset to disable AI generation safely.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
AI_SITE_PROVIDER=openai
# Optional provider-specific override. Leave blank for the adapter default.
AI_MODEL_PLANNER=
# Supported AI endpoints use the Responses API. Configure separate models only
# when they are available to the OpenAI project; the frontend never receives keys.
AI_MODEL_EDITOR=gpt-5
AI_MODEL_COPY=gpt-5
AI_MODEL_IMAGE=
# Base64-encoded 32-byte key; required only when retaining prompts for retry.
AI_PROMPT_ENCRYPTION_KEY=
AI_PROMPT_RETENTION_HOURS=24
