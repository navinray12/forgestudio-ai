NODE_ENV=development

PORT=5000

FRONTEND_URL=http://127.0.0.1:5173

DATABASE_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Server-only AI configuration. Leave unset to disable AI generation safely.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_WORKSPACE_ID=
AI_SITE_PROVIDER=openai
# Optional provider-specific override. Leave blank for the adapter default.
AI_MODEL_PLANNER=
AI_MODEL_GEMINI=gemini-3.5-flash-lite
# Supported AI endpoints use the Responses API. Configure separate models only
# when they are available to the OpenAI project; the frontend never receives keys.
AI_MODEL_EDITOR=gpt-5
AI_MODEL_COPY=gpt-5
AI_MODEL_IMAGE=
# Base64-encoded 32-byte key; required only when retaining prompts for retry.
AI_PROMPT_ENCRYPTION_KEY=
AI_PROMPT_RETENTION_HOURS=24
AI_PROMPT_CLEANUP_INTERVAL_MS=60000
# Optional Stitch + Claude workflow. Also requires ANTHROPIC_API_KEY and vault key.
STITCH_API_KEY=
AI_DESIGN_PROVIDER=stitch
AI_CLAUDE_DESIGN_MODEL=
AI_STITCH_MODEL=MODEL_ID_UNSPECIFIED
AI_DESIGN_MAX_PAGES=8
AI_ARTIFACT_DIRECTORY=.data/ai-artifacts

# Category F: Data & Application Platform (MinIO & Encryption)
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001
MINIO_ROOT_USER=forge_minio_admin
MINIO_ROOT_PASSWORD=forge_minio_secret_key_123
DATA_PLATFORM_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Gmail SMTP: use a Google App Password; enter credentials only in backend/.env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional explicit local-only code file. Absolute path directly inside OS temp.
# When enabled in local auth mode, the same code is also attempted over SMTP.
FORGE_LOCAL_OTP_FILE=
# Runtime Sandbox & Execution Isolation (SEC-02)
# In production, set to 'docker', 'gvisor', or 'firecracker' to enable isolated tenant process execution.
# Untrusted tenant commands will NEVER execute on the application host when NODE_ENV=production.
FORGE_CONTAINER_RUNTIME=
# Development/testing ONLY: optionally set to 'true' to allow local host command execution
# with strict secret purging and path traversal escape guards during local dev.
# This setting is strictly ignored in production (NODE_ENV=production).
FORGE_ALLOW_UNSAFE_HOST_EXECUTION=false


