generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  fullName            String?
  email               String?              @unique
  phone               String?              @unique
  authEpoch           Int                  @default(1)
  passwordHash        String?
  verificationMethod  VerificationMethod?
  emailVerified       Boolean              @default(false)
  phoneVerified       Boolean              @default(false)
  status              UserStatus           @default(ACTIVE)
  role                UserRole             @default(USER)
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  identities          Identity[]
  otpVerifications    OtpVerification[]
  passwordResetTokens PasswordResetToken[]
  sessions            Session[]
  authChallenges      AuthChallenge[]
  oidcIdentities      OidcIdentity[]
  templates           templates[]
  subscription        UserSubscription?
  websites            Website[]
  codeRevisions       CustomCodeRevision[]
  auditLogs           AuditLog[]
  developerApiKeys    DeveloperApiKey[]
  designNotes         DesignNote[]
  collaborations      WebsiteCollaborator[]
  componentAccesses   ComponentAccess[]
  customEntries       CustomEntry[]
  websiteRevisions    WebsiteRevision[]
  deployments         Deployment[]
  wpConnections       WordPressConnection[]
  ownedTeams          Team[]               @relation("TeamOwner")
  teamMemberships     TeamMember[]
  sentTeamInvitations TeamInvitation[]     @relation("TeamInvitedBy")
  sentWebsiteInvitations WebsiteInvitation[] @relation("WebsiteInvitedBy")
  granularPermissions GranularPermission[]
  ownedWorkspaces     Workspace[]
  ownedOrganizations      Organization[]       @relation("OrgOwner")
  organizationMemberships OrganizationMember[]
  workspaceMemberships    WorkspaceMember[]
  approvalRequests        PublishApprovalRequest[] @relation("ApprovalRequester")
  reviewedApprovals       PublishApprovalRequest[] @relation("ApprovalReviewer")
  mediaAssets             MediaAsset[]
  optimizationCredits     Int                      @default(250)
  creditLedgers           OptimizationCreditLedger[]
  licenses                License[]
  whiteLabelConfig        WhiteLabelConfig?
  invoices                BillingInvoice[]
  aiExecutions            AiExecution[]
  aiChangesets            AiChangeset[]


  @@index([status])
  @@index([role])
  @@map("users")
}

model Website {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String                @db.Uuid
  name               String                @db.VarChar(255)
  slug               String                @db.VarChar(255)
  status             String                @default("DRAFT") @db.VarChar(50)
  editorData         Json                  @default("{\"version\": 1, \"elements\": []}")
  documentVersion    Int                   @default(1)
  performanceSettings Json                @default("{}")
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customCodeSnippets CustomCodeSnippet[]
  formSubmissions    FormSubmission[]
  customPostTypes    CustomPostType[]
  themeLocationRules ThemeLocationRule[]
  sftpConnections    SftpConnection[]
  pluginIntegrations PluginIntegration[]
  designNotes        DesignNote[]
  componentAccesses  ComponentAccess[]
  collaborators      WebsiteCollaborator[]
  revisions          WebsiteRevision[]
  deployments        Deployment[]
  wpConnection       WordPressConnection?
  wpPageMappings     WordPressPageMapping[]
  granularPermissions GranularPermission[]
  invitations         WebsiteInvitation[]
  teamId              String?              @db.Uuid
  team                Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  workspaceId         String?              @db.Uuid
  workspace           Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  organizationId      String?              @db.Uuid
  organization        Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  approvalWorkflowEnabled Boolean          @default(false)
  approvalRequests    PublishApprovalRequest[]
  mediaAssets         MediaAsset[]
  mailerConfig        SiteMailerConfig?
  emailLogs           EmailDeliveryLog[]
  performanceMetrics  SitePerformanceMetric[]
  optimizedMedia      MediaOptimizationAsset[]
  aiExecutions        AiExecution[]
  aiChangesets        AiChangeset[]

  @@index([userId], map: "idx_websites_user_id")
  @@index([organizationId])
  @@map("websites")
}

model OtpVerification {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String?     @db.Uuid
  email      String?
  otpHash    String
  purpose    OtpPurpose
  channel    OtpChannel? @default(EMAIL)
  attempts   Int         @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime    @default(now())
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([purpose])
  @@map("otp_verifications")
}

model Identity {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  provider       IdentityProvider
  providerUserId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("identities")
}

model AuthChallenge {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String?  @db.Uuid
  kind                String
  secretHash          String   @unique
  authEpoch           Int      @default(0)
  status              String   @default("PENDING")
  email               String?
  otpHash             String?
  attempts            Int      @default(0)
  expiresAt           DateTime
  lastSentAt          DateTime?
  createdAt           DateTime @default(now())
  providerKey         String?
  initiatingSessionId String?  @db.Uuid
  user                User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("auth_challenges")
}

model IdentityRateBucket {
  key         String
  windowStart DateTime
  attempts    Int
  expiresAt   DateTime
  @@id([key, windowStart])
  @@index([expiresAt])
  @@map("identity_rate_buckets")
}

model OidcIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  issuer    String
  subject   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([issuer, subject])
  @@unique([userId, issuer])
  @@map("oidc_identities")
}

model Session {
  authEpoch     Int       @default(0)
  authMethod    String    @default("legacy")
  audience      String    @default("TENANT")
  authTime      DateTime?
  assurance     String    @default("none")
  mfaVerifiedAt DateTime?
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model SubscriptionPlan {
  id              String             @id @default(uuid()) @db.Uuid
  name            String
  slug            String             @unique
  price           Int
  currency        String             @default("INR")
  billingInterval String             @default("monthly")
  websiteLimit    Int
  storageLimitMb  Int                @default(100)
  aiCreditLimit   Int                @default(0)
  features        Json
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  subscriptions   UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @unique @db.Uuid
  planId             String           @db.Uuid
  status             String           @default("ACTIVE")
  currentPeriodStart DateTime         @default(now())
  currentPeriodEnd   DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  plan               SubscriptionPlan @relation(fields: [planId], references: [id])
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_subscriptions")
}

model templates {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid
  name         String   @db.VarChar(255)
  description  String?
  type         String   @default("PAGE") @db.VarChar(50)
  templateData Json     @default("{\"elements\": [], \"pageSettings\": {}}")
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @db.Timestamptz(6)
  category     String   @default("Other") @db.VarChar(100)
  isFavorite   Boolean  @default(false)
  isShared     Boolean  @default(false)
  shareToken   String?  @db.VarChar(255)
  users        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([shareToken], map: "idx_templates_share_token")
  @@index([userId], map: "idx_templates_user_id")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
  PLATFORM_ADMIN
  SUPPORT_ADMIN
  DEVELOPER
  AI_CONTENT_ADMIN
  TEAM_MEMBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum VerificationMethod {
  EMAIL
  PHONE
  GITHUB
}

enum IdentityProvider {
  EMAIL
  PHONE
  GOOGLE
  GITHUB
}

enum OtpPurpose {
  PHONE_SIGNUP
  PHONE_LOGIN
  PHONE_VERIFICATION
  EMAIL_SIGNUP
  EMAIL_LOGIN
}

enum OtpChannel {
  EMAIL
  WHATSAPP
}

model CustomCodeSnippet {
  id           String               @id @default(uuid()) @db.Uuid
  websiteId    String               @db.Uuid
  name         String?
  title        String?
  language     String               @default("JS") // JS, CSS, HTML
  codeType     String               @default("JS") // JS, CSS, HTML
  code         String
  placement    String               @default("HEAD") // HEAD, BODY_TOP, BODY_BOTTOM, BODY_START, BODY_END
  location     String               @default("HEAD")
  scope        String               @default("GLOBAL") // GLOBAL, PAGE
  pageId       String?
  conditions   Json?                @default("[]")
  priority     Int                  @default(10)
  status       String               @default("PUBLISHED") // DRAFT, PUBLISHED, SCHEDULED
  scheduledFor DateTime?
  isEnabled    Boolean              @default(true)
  isActive     Boolean              @default(true)
  isDraft      Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  website   Website              @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  revisions CustomCodeRevision[]

  @@index([websiteId])
  @@map("custom_code_snippets")
}

model CustomCodeRevision {
  id        String            @id @default(uuid()) @db.Uuid
  snippetId String            @db.Uuid
  code      String
  authorId  String?           @db.Uuid
  createdAt DateTime          @default(now())

  snippet CustomCodeSnippet @relation(fields: [snippetId], references: [id], onDelete: Cascade)
  author  User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([snippetId])
  @@map("custom_code_revisions")
}

model FormSubmission {
  id        String   @id @default(uuid()) @db.Uuid
  websiteId String   @db.Uuid
  formId    String
  data      Json
  ipAddress String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([formId])
  @@map("form_submissions")
}

model CustomPostType {
  id          String   @id @default(uuid()) @db.Uuid
  websiteId   String   @db.Uuid
  name        String
  slug        String
  description String?
  supports    Json     @default("[\"title\", \"editor\", \"thumbnail\"]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  website Website       @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  fields  CustomField[]
  entries CustomEntry[]

  @@unique([websiteId, slug])
  @@map("custom_post_types")
}

model ThemeLocationRule {
  id           String   @id @default(uuid()) @db.Uuid
  websiteId    String   @db.Uuid
  locationType String // HEADER, FOOTER, SINGLE, ARCHIVE, ERROR404
  templateId   String
  conditions   Json     @default("[]")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, locationType])
  @@map("theme_location_rules")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @db.Uuid
  action         String
  targetResource String
  details        Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

model SftpConnection {
  id         String   @id @default(uuid()) @db.Uuid
  websiteId  String   @db.Uuid
  host       String
  port       Int      @default(22)
  username   String
  remotePath String   @default("/var/www/html")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@map("sftp_connections")
}

model PluginIntegration {
  id         String   @id @default(uuid()) @db.Uuid
  websiteId  String   @db.Uuid
  pluginSlug String // acf, toolset, pods, learndash, lifterlms
  config     Json     @default("{}")
  isEnabled  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, pluginSlug])
  @@map("plugin_integrations")
}

model MultisiteNetwork {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  domain      String   @unique
  networkType String   @default("SUBDIRECTORY") // SUBDIRECTORY | SUBDOMAIN
  config      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("multisite_networks")
}

model CustomField {
  id         String   @id @default(uuid()) @db.Uuid
  postTypeId String   @db.Uuid
  name       String
  slug       String
  type       String   @default("text")
  order      Int      @default(0)
  config     Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  postType CustomPostType @relation(fields: [postTypeId], references: [id], onDelete: Cascade)

  @@map("custom_fields")
}

model CustomEntry {
  id         String   @id @default(uuid()) @db.Uuid
  postTypeId String   @db.Uuid
  title      String
  slug       String?
  data       Json     @default("{}")
  status     String   @default("PUBLISHED")
  authorId   String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  postType CustomPostType @relation(fields: [postTypeId], references: [id], onDelete: Cascade)
  author   User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@map("custom_entries")
}

model DesignNote {
  id        String   @id @default(uuid()) @db.Uuid
  websiteId String   @db.Uuid
  elementId String?
  authorId  String   @db.Uuid
  content   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("design_notes")
}

model PluginCompatibility {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  slug                String   @unique
  category            String?
  compatibilityStatus String   @default("SUPPORTED")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("plugin_compatibilities")
}

model DeveloperApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  name       String
  tokenHash  String    @unique
  scopes     Json      @default("[\"websites:read\"]")
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("developer_api_keys")
}

model ComponentAccess {
  id          String   @id @default(uuid()) @db.Uuid
  websiteId   String   @db.Uuid
  componentId String
  elementId   String   @default("")
  userId      String?  @db.Uuid
  permission  String   @default("VIEW")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([websiteId, componentId])
  @@map("component_accesses")
}

model WebsiteCollaborator {
  id         String   @id @default(uuid()) @db.Uuid
  websiteId  String   @db.Uuid
  userId     String   @db.Uuid
  permission String   @default("EDITOR")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([websiteId, userId])
  @@map("website_collaborators")
}

model WebsiteRevision {
  id           String   @id @default(uuid()) @db.Uuid
  websiteId    String   @db.Uuid
  version      Int
  revisionType String   @default("MANUAL") @db.VarChar(50) // MANUAL, PUBLISH, CHECKPOINT, RESTORE
  description  String?  @db.VarChar(500)
  data         Json
  createdBy    String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  creator User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([websiteId, version])
  @@index([websiteId])
  @@index([websiteId, createdAt])
  @@map("website_revisions")
}

model Deployment {
  id               String    @id @default(uuid()) @db.Uuid
  websiteId        String    @db.Uuid
  version          Int
  status           String    @default("QUEUED") @db.VarChar(50) // QUEUED, VALIDATING, BUILDING, PROCESSING, DEPLOYING, VERIFYING, PUBLISHED, RECONCILIATION_REQUIRED, VALIDATION_FAILED, BUILD_FAILED, DEPLOY_FAILED, VERIFICATION_FAILED
  environment      String    @default("PRODUCTION") @db.VarChar(50) // PRODUCTION, STAGING, DEVELOPMENT
  destinationType  String    @default("INTERNAL") @db.VarChar(50) // INTERNAL, WORDPRESS, STATIC
  destinationRef   String?   @db.VarChar(500)
  sourceRevisionId String?   @db.Uuid
  metadata         Json?     @default("{}")
  error            Json?
  startedAt        DateTime  @default(now()) @db.Timestamptz(6)
  completedAt      DateTime? @db.Timestamptz(6)
  createdBy        String?   @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  creator User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([websiteId])
  @@index([websiteId, createdAt])
  @@index([status])
  @@map("deployments")
}

model WordPressConnection {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  websiteId      String    @unique @db.Uuid
  siteUrl        String    @db.VarChar(500)
  status         String    @default("PENDING") @db.VarChar(50) // PENDING, CONNECTING, CONNECTED, FAILED, DISCONNECTED, REVOKED
  wpSiteName     String?   @db.VarChar(255)
  apiKeyHash     String    @db.VarChar(255)
  capabilities   Json?     @default("[]")
  metadata       Json?     @default("{}")
  pluginVersion  String?   @default("1.0.0") @db.VarChar(50)
  apiVersion     String?   @default("v1") @db.VarChar(50)
  failureReason  String?   @db.VarChar(500)
  revokedAt      DateTime? @db.Timestamptz(6)
  lastSyncedAt   DateTime? @db.Timestamptz(6)
  lastVerifiedAt DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wordpress_connections")
}

model WordPressPageMapping {
  id           String   @id @default(uuid()) @db.Uuid
  websiteId    String   @db.Uuid
  forgePageId  String   @db.VarChar(100)
  wpPostId     Int
  wpPostSlug   String?  @db.VarChar(255)
  wpPostUrl    String?  @db.VarChar(500)
  lastSyncedAt DateTime @default(now()) @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, forgePageId])
  @@index([websiteId])
  @@map("wordpress_page_mappings")
}

model GranularPermission {
  id         String   @id @default(uuid()) @db.Uuid
  websiteId  String   @db.Uuid
  userId     String   @db.Uuid
  resourceId String   @default("*") @db.VarChar(100)
  capability String   @db.VarChar(100)
  effect     String   @default("ALLOW") @db.VarChar(20) // ALLOW, DENY
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([websiteId, userId, resourceId, capability])
  @@index([websiteId])
  @@index([userId])
  @@map("granular_permissions")
}

model Team {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.VarChar(500)
  ownerId     String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  owner       User             @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  websites    Website[]
  invitations TeamInvitation[]

  @@index([ownerId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @db.Uuid
  userId    String   @db.Uuid
  role      String   @default("DESIGNER") @db.VarChar(50) // OWNER, ADMIN, DESIGNER, CONTENT_EDITOR, REVIEWER
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model TeamInvitation {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @db.Uuid
  email     String   @db.VarChar(255)
  role      String   @default("DESIGNER") @db.VarChar(50)
  tokenHash String   @unique @db.VarChar(255)
  status    String   @default("PENDING") @db.VarChar(50) // PENDING, ACCEPTED, REJECTED, EXPIRED
