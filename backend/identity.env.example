# Merge with deployment configuration. Values below are placeholders, not secrets.
# Production requires the OIDC mode; local passwords/OTP cannot be enabled there.
FORGE_AUTH_MODE=oidc
FRONTEND_URL=https://studio.example.invalid
OIDC_ISSUER=https://identity.example.invalid/realms/forge
OIDC_CLIENT_ID=forge-customer
# Inject OIDC_CLIENT_SECRET from the approved secret store; never commit its value.
# OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=https://api.example.invalid/api/v1/auth/oidc/callback
OIDC_ALLOWED_ORIGINS=https://identity.example.invalid
# These are examples, NOT universal vendor claims. Security must approve the
# actual ACR -> factor mapping and the identity provider's enrollment/recovery.
OIDC_MFA_ACRS=urn:example:mfa
OIDC_PHISHING_RESISTANT_ACRS=urn:example:webauthn

# Local development only. SMTP must accept TLS and the actual recipient.
# SMTP_HOST=smtp.example.invalid
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.invalid
