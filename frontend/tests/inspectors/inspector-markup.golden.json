  "display-conditions": "<div class=\"space-y-3 pt-2 border-t border-slate-100\"><div class=\"flex items-center justify-between\"><h3 class=\"text-xs font-bold uppercase tracking-wider text-purple-600 flex items-center gap-1.5\"><span>👁️</span> Display Conditions &amp; Location Rules</h3></div><div class=\"flex items-center gap-1.5 pt-1\"><button type=\"button\" class=\"flex-1 flex items-center justify-center gap-1 px-2 py-1 text-[11px] font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 rounded-lg transition shadow-2xs cursor-pointer active:scale-95\" title=\"Copy current display conditions to clipboard\"><span>📋</span><span>Copy</span></button><button type=\"button\" class=\"flex-1 flex items-center justify-center gap-1 px-2 py-1 text-[11px] font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 rounded-lg transition shadow-2xs cursor-pointer active:scale-95\" title=\"Paste display conditions from clipboard\"><span>📥</span><span>Paste</span></button><button type=\"button\" class=\"flex items-center justify-center gap-1 px-2 py-1 text-[11px] font-semibold rounded-lg border transition shadow-2xs cursor-pointer text-red-600 bg-red-50 hover:bg-red-100 border-red-200\" title=\"Clear all conditions and reset to Entire Website\"><span>🗑️</span><span>Clear</span></button></div><div class=\"space-y-3 pt-3 border-t border-slate-100\"><div class=\"flex items-center justify-between\"><h4 class=\"text-xs font-bold text-slate-800 flex items-center gap-1.5\"><span>⚙️</span> Conditions List (2)</h4><button type=\"button\" class=\"text-[11px] font-bold text-blue-600 hover:text-blue-800 bg-blue-50 hover:bg-blue-100 border border-blue-200 px-2.5 py-1 rounded-lg shadow-xs transition flex items-center gap-1 cursor-pointer\"><span>+ Add Item</span></button></div><div class=\"space-y-2.5\"><div data-item-index=\"0\" draggable=\"true\" class=\"rounded-xl border bg-white p-3 shadow-xs space-y-2.5 transition-all duration-150 border-slate